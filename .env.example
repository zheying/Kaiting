# 必填：首次初始化管理员 admin 的密码；之后修改此变量不会覆盖已有账号密码。
ADMIN_PASSWORD=
# 必填：使用 openssl rand -hex 32 生成；请勿使用示例字符串。
COOKIE_SECRET=
# HTTPS/反向代理使用 true；可信局域网直接 HTTP 访问需显式改为 false。
COOKIE_SECURE=true
# 可选：页面入口与独立 NAS 媒体入口；配套设置后启用自动检测。
# 两者使用同一主域名及 HTTPS，不包含路径；代理保留含端口的 Host。
# PUBLIC_ORIGIN=https://music.example.com
# DIRECT_MEDIA_ORIGIN=https://direct.music.example.com:5443
# 主机上的音乐目录；Compose 会把它只读挂载到容器 /music。
MUSIC_LIBRARY_PATH=/path/to/your/music
# 本地 Node.js 可选：额外允许的根目录（macOS/Linux 冒号分隔）。
# Docker 需另行添加容器只读卷与环境变量；此处不能直接选择未挂载的主机路径。
# MUSIC_LIBRARY_ROOTS=/mnt/music-archive:/mnt/another-library
# 主机上的持久化目录；Compose 会把它挂载到容器 /data。
DATA_DIR=./data
ENABLE_ONLINE_METADATA=false
# 在线能力开启后，是否也在扫描时逐曲查找标签、封面和歌词。
# 只需要扫描后的后台专辑补全时设为 false，避免扫描等待大量网络请求。
SCAN_ONLINE_METADATA=true
# 扫描完成后在后台补齐专辑年份、流派，唯一可靠匹配直接保存（仍需开启在线能力）。
AUTO_COMPLETE_ALBUM_METADATA=true
# Compose 的主机发布端口；容器内部固定监听 3000。
PORT=3000
# 可选：部署镜像标签；留空时使用 music-library:local。
MUSIC_LIBRARY_IMAGE=music-library:local
