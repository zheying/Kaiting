# 必填：设置自己的登录密码，禁止保留空值。
ADMIN_PASSWORD=
# 必填：使用 openssl rand -hex 32 生成；请勿使用示例字符串。
COOKIE_SECRET=
# HTTPS/反向代理使用 true；可信局域网直接 HTTP 访问需显式改为 false。
COOKIE_SECURE=true
# 主机上的音乐目录；Compose 会把它只读挂载到容器 /music。
MUSIC_LIBRARY_PATH=/path/to/your/music
# 主机上的持久化目录；Compose 会把它挂载到容器 /data。
DATA_DIR=./data
ENABLE_ONLINE_METADATA=false
# Compose 的主机发布端口；容器内部固定监听 3000。
PORT=3000
# 可选：部署镜像标签；留空时使用 music-library:local。
MUSIC_LIBRARY_IMAGE=music-library:local
