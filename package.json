{
  "name": "nas-music-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prototype": "npm --prefix prototypes/listening-room run dev",
    "prototype:build": "npm --prefix prototypes/listening-room run build",
    "prototype:preview": "npm --prefix prototypes/listening-room run preview",
    "dev": "concurrently -k \"PORT=3001 tsx watch src/server/index.ts\" \"API_PORT=3001 vite --host 0.0.0.0 --port 3000 --strictPort\"",
    "server": "tsx src/server/index.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "NODE_ENV=production node dist/server/server/index.js",
    "data:backup": "node dist/server/server/maintenance.js backup",
    "data:restore": "node dist/server/server/maintenance.js restore",
    "data:import-artwork": "node dist/server/server/artwork-import.js",
    "test": "node scripts/test.mjs files",
    "test:list": "node scripts/test.mjs list",
    "test:inventory": "node scripts/test.mjs inventory",
    "test:scope": "node scripts/test.mjs scope",
    "test:unit": "node scripts/test.mjs unit",
    "test:integration": "node scripts/test.mjs integration",
    "test:prototype": "node scripts/test.mjs prototype",
    "test:all": "node scripts/test.mjs all",
    "test:ci": "node scripts/ci.mjs",
    "test:selection": "node scripts/verify-test-selection.mjs",
    "test:browser": "node scripts/verify-e2e-browser.mjs",
    "test:e2e": "node scripts/e2e.mjs selected",
    "test:e2e:all": "node scripts/e2e.mjs all",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.e2e.json",
    "test:ci:node": "node scripts/test.mjs ci"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.5",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.12.5",
    "lucide-react": "^0.468.0",
    "music-metadata": "^11.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.1.10",
    "vitest": "^4.1.8"
  }
}
